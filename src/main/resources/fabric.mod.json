{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}@geocore.credits@",
    "contact": {
        "homepage": "@geocore.homepage@",
        "sources": "@geocore.sources@",
        "issues": "@geocore.issues@"
    },
    "authors": [
        "${mod_author}"
    ],
    "license": "${mod_license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "*",
    "entrypoints": {
        "geocore:entry": [
            "fr.geoventure.geontm.gametest.GameTestEntry",
            "fr.geoventure.geontm.platform.fabric.FabricInit"
        ],
        "client": [
            "fr.geoventure.geontm.client.HarnessQueriesFabricEntry",
            "fr.geoventure.geontm.platform.fabric.FabricClientInit"
        ],
        "jei_mod_plugin": [
            "fr.geoventure.geontm.handler.jei.GeoNtmJeiPluginFabric"
        ],
        "rei_client": [
            "fr.geoventure.geontm.handler.rei.GeoNtmReiClientPlugin"
        ],
        "rei_common": [
            "fr.geoventure.geontm.handler.rei.GeoNtmReiCommonPlugin"
        ],
        "emi": [
            "fr.geoventure.geontm.handler.emi.GeoNtmEmiPlugin"
        ],
        "fabric-gametest": [
            "fr.geoventure.geontm.platform.fabric.FabricGameTests"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "fabric-api": "*",
        "geocore": ">=1.0.6",
        "minecraft": "${minecraft_range}",
        "java": ">=${java_version}"
    },
    "breaks": {
        "gemrender": "<0.1.22"
    }
}
